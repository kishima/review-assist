{
  // webview（ブラウザ）の側だけ DOM の型を使う。拡張本体の tsconfig.json には DOM を入れない
  // （拡張の側で DOM を触る書き間違いを型で止めるため）。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    // esbuild が束ねるので、ES モジュールの解決（pdf.js の .mjs を読むため）
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "..",
    "types": []
  },
  "include": ["./**/*.ts"],
  "exclude": []
}
