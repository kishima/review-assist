{
  "contentDir": "contents",
  "chapters": {
    "gen": [
      "sub/*.re"
    ]
  },
  "imagePreview": "images/png/{chapter}/{id}.png",
  "pdf": "sample.pdf",
  "pageIndex": "pages.json",
  "maxCodeLineLength": 20,
  "rules": [
    {
      "id": "old-notation",
      "pattern": "\\bR\\([0-9A-Za-z]\\)",
      "message": "旧表記",
      "scope": "prose"
    },
    {
      "id": "code-tab",
      "pattern": "\\t",
      "message": "コードのタブ",
      "scope": "code"
    }
  ]
}
