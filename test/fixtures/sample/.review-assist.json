{
  "contentDir": "contents",
  "chapters": { "gen": ["sub/*.re"] },
  "imagePreview": "images/png/{chapter}/{id}.png",
  "maxCodeLineLength": 20,
  "rules": [
    { "id": "old-notation", "pattern": "\\bR\\([0-9A-Za-z]\\)", "message": "\u65e7\u8868\u8a18", "scope": "prose" },
    { "id": "code-tab", "pattern": "\\t", "message": "\u30b3\u30fc\u30c9\u306e\u30bf\u30d6", "scope": "code" }
  ]
}
