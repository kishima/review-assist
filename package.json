{
  "name": "review-assist",
  "displayName": "Review Assist",
  "description": "Re:VIEW の原稿を見直すための補助（構文色付け・索引・定義へ移動・ホバー・アウトライン・参照切れと規則の診断・マーカーとまとめて AI に頼む仕組み・記法を畳む編集画面）",
  "version": "0.2.0",
  "publisher": "kishima",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kishima/review-assist.git"
  },
  "homepage": "https://github.com/kishima/review-assist#readme",
  "bugs": {
    "url": "https://github.com/kishima/review-assist/issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:review",
    "workspaceContains:**/catalog.yml",
    "onCustomEditor:reviewAssist.editor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "review",
        "aliases": [
          "Re:VIEW",
          "review"
        ],
        "extensions": [
          ".re"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "review",
        "scopeName": "source.review",
        "path": "./syntaxes/review.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "reviewAssist.reindex",
        "title": "Review Assist: ワークスペースを索引し直す"
      },
      {
        "command": "reviewAssist.showIndexStats",
        "title": "Review Assist: 索引の状態を表示する"
      },
      {
        "command": "reviewAssist.openInPdf",
        "title": "Review Assist: この節を PDF で開く"
      },
      {
        "command": "reviewAssist.addMarkAiCheck",
        "title": "Review Assist: マーカーを付ける: AI チェック"
      },
      {
        "command": "reviewAssist.addMarkReadLater",
        "title": "Review Assist: マーカーを付ける: 後で読む"
      },
      {
        "command": "reviewAssist.addMark",
        "title": "Review Assist: マーカーを付ける（種類を選ぶ）"
      },
      {
        "command": "reviewAssist.removeMark",
        "title": "Review Assist: マーカーを外す",
        "icon": "$(trash)"
      },
      {
        "command": "reviewAssist.toggleMarkDone",
        "title": "Review Assist: マーカーの済み／未済を切り替える",
        "icon": "$(check)"
      },
      {
        "command": "reviewAssist.editMarkNote",
        "title": "Review Assist: マーカーのメモを直す",
        "icon": "$(edit)"
      },
      {
        "command": "reviewAssist.applySuggestion",
        "title": "Review Assist: AI の案を当てる",
        "icon": "$(lightbulb)"
      },
      {
        "command": "reviewAssist.writeAiRequest",
        "title": "Review Assist: AI チェックの依頼を書き出す",
        "icon": "$(export)"
      },
      {
        "command": "reviewAssist.filterMarks",
        "title": "Review Assist: マーカーを絞る（未済／済み／全部）",
        "icon": "$(filter)"
      },
      {
        "command": "reviewAssist.openMark",
        "title": "Review Assist: マーカーを開く"
      },
      {
        "command": "reviewAssist.toggleEditor",
        "title": "Review Assist: 記法を畳む編集画面 ⇔ 普通のエディタ",
        "icon": "$(preview)"
      },
      {
        "command": "reviewAssist.wrapCode",
        "title": "Review Assist: 選んだ所を @<code>{} で囲む"
      },
      {
        "command": "reviewAssist.wrapBold",
        "title": "Review Assist: 選んだ所を @<b>{} で囲む"
      },
      {
        "command": "reviewAssist.wrapInline",
        "title": "Review Assist: 選んだ所をインライン命令で囲む（命令を選ぶ）"
      },
      {
        "command": "reviewAssist.insertBlock",
        "title": "Review Assist: ブロックの雛形を入れる"
      }
    ],
    "configuration": {
      "title": "Review Assist",
      "properties": {
        "reviewAssist.enable": {
          "type": "boolean",
          "default": true,
          "description": "拡張を有効にする"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "reviewAssist.marks",
          "name": "マーカー",
          "when": "reviewAssist.hasBook"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "reviewAssist.writeAiRequest",
          "when": "view == reviewAssist.marks",
          "group": "navigation@1"
        },
        {
          "command": "reviewAssist.filterMarks",
          "when": "view == reviewAssist.marks",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "reviewAssist.toggleMarkDone",
          "when": "view == reviewAssist.marks && viewItem =~ /^mark\\./",
          "group": "inline@1"
        },
        {
          "command": "reviewAssist.applySuggestion",
          "when": "view == reviewAssist.marks && viewItem =~ /\\.suggestion$/",
          "group": "inline@2"
        },
        {
          "command": "reviewAssist.editMarkNote",
          "when": "view == reviewAssist.marks && viewItem =~ /^mark\\./",
          "group": "1@1"
        },
        {
          "command": "reviewAssist.removeMark",
          "when": "view == reviewAssist.marks && viewItem =~ /^mark\\./",
          "group": "1@2"
        }
      ],
      "editor/context": [
        {
          "command": "reviewAssist.addMarkAiCheck",
          "when": "editorLangId == review && editorHasSelection",
          "group": "reviewAssist@1"
        },
        {
          "command": "reviewAssist.addMarkReadLater",
          "when": "editorLangId == review && editorHasSelection",
          "group": "reviewAssist@2"
        }
      ],
      "commandPalette": [
        {
          "command": "reviewAssist.openMark",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "reviewAssist.toggleEditor",
          "when": "resourceExtname == .re || activeCustomEditorId == reviewAssist.editor",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "reviewAssist.addMarkAiCheck",
          "when": "webviewId == 'reviewAssist.editor'",
          "group": "reviewAssist@1"
        },
        {
          "command": "reviewAssist.addMarkReadLater",
          "when": "webviewId == 'reviewAssist.editor'",
          "group": "reviewAssist@2"
        },
        {
          "command": "reviewAssist.wrapCode",
          "when": "webviewId == 'reviewAssist.editor'",
          "group": "reviewAssist2@1"
        },
        {
          "command": "reviewAssist.wrapBold",
          "when": "webviewId == 'reviewAssist.editor'",
          "group": "reviewAssist2@2"
        },
        {
          "command": "reviewAssist.insertBlock",
          "when": "webviewId == 'reviewAssist.editor'",
          "group": "reviewAssist2@3"
        },
        {
          "command": "reviewAssist.toggleEditor",
          "when": "webviewId == 'reviewAssist.editor'",
          "group": "reviewAssist3@1"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "reviewAssist.editor",
        "displayName": "Review Assist（記法を畳む）",
        "selector": [
          {
            "filenamePattern": "*.re"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview",
    "test": "node esbuild.mjs && node --test test/*.test.js",
    "cli": "node dist/cli.js",
    "package": "node esbuild.mjs && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.19.0",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
